NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://bravy:bravy123@localhost:5432/chat_bullq

# JWT
JWT_SECRET=change-me-generate-with-node-e-require-crypto-randomBytes-64-toString-hex
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-generate-another-different-one
JWT_REFRESH_EXPIRATION=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# CORS
CORS_ORIGIN=http://localhost:3000

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=bravy
MINIO_SECRET_KEY=bravy123minio
MINIO_BUCKET=chat-bullq

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bravy.com

OPENAI_API_KEY=sk-proj-your-key-here

# ─── WhatsApp Embedded Signup (Tech Provider) ───────────────────────────────
# Preencher quando a Business Verification da Meta for aprovada e o app sair
# do modo dev. APP_ID/APP_SECRET são do app Meta (Settings → Basic).
META_APP_ID=
META_APP_SECRET=
# Versão da Graph API usada nas chamadas de onboarding (default v21.0).
META_GRAPH_VERSION=v21.0
# Opcional: PIN de 2FA pra registrar o número na Cloud API (POST /{id}/register).
# Se vazio, o register é pulado (ok quando o número já vem registrado do ES).
META_PHONE_REGISTER_PIN=
